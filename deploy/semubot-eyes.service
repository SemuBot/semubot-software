[Unit]
Description=SemuBot face on the head screen
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# deploy/semubot replaces REPO with the checkout path
ExecStart=REPO/deploy/run.sh ros2 run semubot_eyes eye_controller
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
