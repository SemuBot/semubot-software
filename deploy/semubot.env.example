# Copied to ~/.config/semubot/semubot.env by deploy/semubot install; that copy is not in git.
# Which computer this is: pi (drive stack) or nuc (speech, face, webapp, chest display).
SEMUBOT_MACHINE=
# Robot revision: config/profiles/<name>.yaml in semubot_bringup, read by the drive stack, the webapp and the chest display.
SEMUBOT_PROFILE=v2
ROS_DOMAIN_ID=5
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# CYCLONEDDS_URI=file:///home/semubot/cyclonedds.xml
# Pi: serial device of the STM32 wheelbase; deploy/99-semubot-wheelbase.rules creates the default.
# SEMUBOT_WHEELBASE_PORT=/dev/semubot_wheelbase
# NUC: where the webapp container reaches rosbridge (Docker's host address).
ROSBRIDGE_HOST=172.17.0.1
ROSBRIDGE_PORT=9090
